rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cupones: cualquiera puede validar un código (lectura pública),
    // pero solo un admin autenticado puede crear/editar/borrar
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Artículos del blog: público solo ve los publicados,
    // el admin autenticado ve y edita todo
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || request.auth != null;
      allow write: if request.auth != null;
    }

    // Newsletter: cualquiera puede suscribirse (crear),
    // pero solo el admin puede leer/editar/borrar la lista de correos
    match /newsletter_subscribers/{subId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    // Leads de la landing de diagnóstico: datos personales
    match /leads/{leadId} {
      // Solo el admin puede leer y actualizar (cambiar estado desde el panel).
      allow read, update: if request.auth != null
        && request.auth.uid == "rOjBPvum7KU3Z30nPuU4BoJxzT73";
      // Nadie crea ni borra desde el cliente: la creación va por la ruta API (Admin SDK).
      allow create, delete: if false;
    }
  }
}