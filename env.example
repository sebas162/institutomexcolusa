# Variables de entorno de servidor necesarias para este proyecto:
# - Firebase Admin SDK (usado en generateMetadata, sitemap.ts, y el endpoint de cron)
# - Autenticación del endpoint /api/cron/publish-scheduled-posts
#
# La configuración del SDK cliente de Firebase vive hardcodeada en src/lib/firebase.ts
# (no es sensible, la apiKey de Firebase no necesita ocultarse).

FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=your-base64-encoded-private-key
CRON_SECRET=your-random-secret-for-cron-endpoint-auth
